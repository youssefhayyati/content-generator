# --- LLM (Ollama cloud) ---
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
LLM_MODEL=glm-5.3-flash
# Other Ollama cloud models tested as the agent: deepseek-v4.1-flash, gemma4:31b (see README, Tuning).
# true | false | low | medium | high. GLM 5.3 Flash leaks reasoning into the spoken
# reply when this is false, so "low" is the fastest clean setting.
LLM_THINK=low

# --- ASR (NVIDIA Nemotron 3.5 ASR) ---
ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
# "auto" detects the language; or force a locale like en-US, fr-FR
ASR_LANGUAGE=auto
# streaming = partial transcripts while you talk; offline = transcribe once you stop
ASR_MODE=streaming
# Lookahead tokens -> latency: 0=80ms, 3=320ms, 6=560ms, 13=1120ms
ASR_LOOKAHEAD=3
ASR_DEVICE=cuda
ASR_DTYPE=float16

# --- TTS (OmniVoice) ---
# TTS_NUM_STEP: diffusion steps. 8 is ~2x faster than 16 with no intelligibility loss in tests
TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE=cuda
# float32 on GTX 16xx (fp16 there is slow and gives garbled audio); float16 is fine on RTX cards
TTS_DTYPE=float32
TTS_NUM_STEP=8
TTS_SPEED=1.0
# Voice used to create the default voice once (cached in voices/default.pt)
TTS_VOICE_INSTRUCT=female, moderate pitch, american accent
# Optional: clone a voice instead (wav file, ~5-15 s). If TTS_REF_TEXT is empty the
# clip is transcribed automatically with the ASR model.
TTS_REF_AUDIO=
TTS_REF_TEXT=
# Optional: speech from a VoiceStudio server instead of this PC's GPU (same OmniVoice model),
# e.g. https://<pod-id>-8002.proxy.runpod.net. Empty = OmniVoice here, with the settings above.
TTS_URL=
TTS_API_KEY=
# The voice until the user picks one on the page: a VoiceStudio voice profile's name or id, or a
# catalog voice's id (e.g. feat_04_the_neighbor). Empty = the server's oldest profile. Not an
# OpenAI name like alloy: VoiceStudio gives those a different random voice every sentence.
TTS_VOICE=

# --- Turn taking (server-side VAD) ---
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250

# --- Browser agent (Playwright) ---
BROWSER_ENABLED=true
# The site the agent works on; it opens here at startup
WEBSITE_URL=https://demo.playwright.dev/todomvc/
# false = visible Chromium window (WSLg/desktop); forced true when there is no display
BROWSER_HEADLESS=false
# Cookies and logins persist in this folder: log in once in the window and it sticks
BROWSER_PROFILE_DIR=browser-profile
# Empty = same model as LLM_MODEL
BROWSER_LLM_MODEL=
BROWSER_LLM_THINK=low
BROWSER_MAX_STEPS=25
BROWSER_SCREENSHOTS=true
SKILLS_DIR=skills

# --- Pictures and videos (ComfyUI on RunPod, see comfyui/API.md) ---
# The pod's API URL (port 8000): https://<pod-id>-8000.proxy.runpod.net. Empty = off.
# It changes with every new pod; the key does not.
COMFYUI_URL=
# MANAGER_API_KEY from comfyui/pod.env
COMFYUI_API_KEY=
# What each workflow is for (shown to the assistant)
COMFYUI_DESCRIPTIONS=comfyui/descriptions.yaml
COMFYUI_TIMEOUT_MINUTES=30
# Generated and attached files are kept here and shown in the web UI
MEDIA_DIR=media
# Conversations are kept here, so they can be listed and reopened (not served)
DATA_DIR=data

# --- Content studio (post drafts for Instagram and X) ---
# How to make each kind of post: one markdown file per skill (see skills/content/_template.md)
CONTENT_SKILLS_DIR=skills/content
# Fonts for text on pictures: any .ttf/.otf file here can be used by its file name
FONTS_DIR=fonts
# Music under the videos the assistant makes from posts (make_video): FlowAI Sound's composer.
# Next to FlowAI (its docker compose) that's http://sound:8000, set there already. Empty = voice only.
SOUND_URL=
# Songs written for each video by ACE-Step 1.5 (content-generator/music/, MIT): "upbeat acoustic pop with
# hand claps" for one post, "dark trap beat" for another. Next to FlowAI that's http://music:8000, set
# there already; a RunPod pod's ACE-Step API works the same (plus MUSIC_API_KEY). Empty = moods only.
MUSIC_URL=
MUSIC_API_KEY=
# Lip sync for dubbed videos (dub_video): LatentSync (content-generator/lipsync/, Apache-2.0). On the RunPod
# pod (lipsync/runpod/setup.sh): https://<pod-id>-8004.proxy.runpod.net, with the key from the kit's env as
# LIPSYNC_API_KEY. On this machine's GPU (8 GB free at least): http://lipsync:8000, after
# docker compose --profile lipsync up -d lipsync. Empty = dubbing is off.
LIPSYNC_URL=
LIPSYNC_API_KEY=

# --- FlowAI (content-generator/): saving, finding and scheduling posts ---
# Its API, e.g. http://localhost:8002 for the local docker stack. Empty = off.
# From the agent's own container (docker compose up), use http://host.docker.internal:8002.
FLOWAI_URL=
# The dashboard: links to posts point here. Until FlowAI issues the assistant a token, the
# assistant signs in as this user, and FlowAI only accepts that from one of its
# SANCTUM_STATEFUL_DOMAINS (localhost:5173 in the local stack).
FLOWAI_DASHBOARD_URL=http://localhost:5173
FLOWAI_EMAIL=
FLOWAI_PASSWORD=

# --- The team's phone (hackathon Phone API): posting from its Instagram and X apps ---
# The API base and the team key; the console (https://172.26.0.32/team, sign in with the key) shows the
# phone live. Empty URL = off. From the agent's own container the address must be reachable too.
PHONE_API_URL=
PHONE_API_KEY=
# The hackathon server's certificate is self-signed
PHONE_VERIFY_TLS=false
# Who drives the phone: agent (the phone's own agent, on the organisers' model account); auto (the phone's
# agent, and ours takes a job over when that one fails or hangs, e.g. its account out of balance); direct
# (always ours: it looks at screenshots with PHONE_VISION_MODEL on our Ollama account and taps and types itself).
# The switch on the Assistant page (a draft's From the phone panel) changes it, and its pick is kept from then on.
PHONE_DRIVER=agent
PHONE_VISION_MODEL=kimi-k3
# auto: after the phone's agent had no model to think with, ours starts the jobs for this long
PHONE_AGENT_RETRY_MINUTES=30
# The phone's agent: flash for feedback and other tasks; pro for posting also checks that the post went up
PHONE_MODE=flash
PHONE_POST_MODE=pro
PHONE_MAX_STEPS=40
# How to post and read feedback in each app (one markdown file per skill, see skills/phone/_template.md)
PHONE_SKILLS_DIR=skills/phone
# Check a post's likes, comments and views this long after it went up (0 = only when asked)
PHONE_FEEDBACK_AFTER_MINUTES=60
# While posting, the phone asks an OK for plain input it can't check (Enter in a field it can't read): give it
# by itself, as part of the post you asked for (false: the assistant asks you each time)
PHONE_AUTO_APPROVE_POSTS=true

# Publish the posts FlowAI schedules from this phone when their time comes (needs FLOWAI_URL). FlowAI's
# agent token from its Phones page; empty = fetched by signing in with FLOWAI_EMAIL and FLOWAI_PASSWORD.
# In FlowAI, add the phone on the Phones page (Automation service, device ID heracles-phone) and pick it,
# with automation on, for each Instagram and X account.
PHONE_PUBLISH=true
FLOWAI_AGENT_TOKEN=
# The phone's device ID in FlowAI; empty = the phone API's own (heracles-phone)
PHONE_DEVICE_REF=
PHONE_PUBLISH_POLL_SECONDS=15

# --- Docker (docker-compose.yml) ---
# The port the agent page is published on
AGENT_PORT=8000
