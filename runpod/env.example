# Every key the pod's services need, in one file: on the pod it's /workspace/flowai/env. deploy.sh puts
# runpod/env from this PC there the first time (git ignores it), and keeps the pod's afterwards.
# Keep it private. KEY=value lines; each key goes in the assistant's .env too, under the name shown.

# comfyui (8001): the manager API's key (COMFYUI_API_KEY), and tokens for gated model downloads
MANAGER_API_KEY=
HF_TOKEN=
CIVITAI_TOKEN=

# voicestudio (8002): its API key (TTS_API_KEY)
OMNIVOICE_API_KEY=
OMNIVOICE_ANALYTICS_DISABLED=1

# music (8003): ACE-Step's API key (MUSIC_API_KEY)
ACESTEP_API_KEY=

# lipsync (8004): its API key (LIPSYNC_API_KEY). LatentSync 1.6 needs 18 GB of GPU memory, 1.5 needs 8
LIPSYNC_API_KEY=
LATENTSYNC_VERSION=1.6

# faceswap (8005): its API key (FACESWAP_API_KEY)
FACESWAP_API_KEY=
