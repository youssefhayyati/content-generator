<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned so a developer's local .env can't leak into assertions. -->
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <!-- Model credentials too. Tests fake their generators; a real key here both changes
             which models count as available and sends live, billable requests from a test run. -->
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="AI_GATEWAY_URL" value=""/>
        <env name="AI_GATEWAY_KEY" value=""/>
        <env name="AI_GATEWAY_REACH" value="Gateway"/>
        <env name="AI_GATEWAY_IMAGE_MODELS" value=""/>
        <env name="AI_GATEWAY_LOCAL_MODELS" value=""/>
        <env name="OLLAMA_URL" value=""/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Tests fake the generator bindings; never let a real .env point the agents elsewhere. -->
        <env name="AI_DEFAULT_TEXT" value="anthropic/claude-opus-5" force="true"/>
        <env name="AI_AGENTS_MODEL" value="anthropic/claude-opus-5-5" force="true"/>
        <!-- Provider keys off: tests decide per-test what's configured. -->
        <env name="OLLAMA_CLOUD_API_KEY" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <env name="OPENROUTER_API_KEY" value="" force="true"/>
        <!-- Local services too: a dev box running Ollama or FlowAI Sound mustn't leak into tests. -->
        <env name="OLLAMA_URL" value="" force="true"/>
        <env name="SOUND_URL" value="" force="true"/>
        <env name="VOICESTUDIO_URL" value="" force="true"/>
        <env name="VOICESTUDIO_KEY" value="" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
