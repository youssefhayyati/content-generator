APP_NAME=FlowAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:5175

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@flowai.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social login. Leave blank to keep a provider switched off; its button will say so.
# Callback URLs to register with each provider:
#   Google: http://localhost:5173/oauth/google/callback
#   GitHub: http://localhost:5173/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI writing in the composer. Leave blank to keep it switched off; the composer will say so.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Free text models. Any or all of these; each appears in the model picker once its key is set.
# Groq: free key at https://console.groq.com/keys (fast Llama 3.3 70B, free tier)
GROQ_API_KEY=
# OpenRouter: free key at https://openrouter.ai/keys (the picker lists the ':free' models)
OPENROUTER_API_KEY=
# Ollama Cloud (ollama.com): hosted big models, free-tier key at ollama.com/settings/keys.
OLLAMA_CLOUD_API_KEY=
# Ollama: local models, no key. The docker-compose ollama service answers at this address.
OLLAMA_URL=http://ollama:11434

# Which models write and plan. The defaults are keyless: the local Ollama. With a real key
# in place, point these at it, e.g. anthropic/claude-opus-5-5.
AI_DEFAULT_TEXT=ollama/llama3.2:1b
AI_AGENTS_MODEL=ollama/llama3.2:1b

# FlowAI Sound (sound/): voices, listening and the composer. docker compose runs it.
SOUND_URL=http://sound:8000

# VoiceStudio (optional): cloned and designed voices from a VoiceStudio server, offered next to
# the local voices. The key is the bearer token its remote auth expects (unset for loopback).
VOICESTUDIO_URL=
VOICESTUDIO_KEY=

# Text models through any OpenAI-compatible gateway: Ollama Cloud (https://ollama.com/v1,
# key from ollama.com/settings/keys), OpenRouter, a team gateway, vLLM or LM Studio. The
# models themselves are discovered from GET {url}/models, so there is no list to maintain.
# AI_GATEWAY_REACH is only the label the model picker shows.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_GATEWAY_REACH=Gateway

# Creative Lab media providers. Keep real credentials in backend/.env only.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_PLAN=ideogram-4,wan-2-7-i2v,soul-v2,soul,soul-cinema,grok-image-2,kling-3-pro,seedance-2,hailuo-2-3
GEMINI_API_KEY=
GOOGLE_GENAI_URL=https://generativelanguage.googleapis.com/v1beta
