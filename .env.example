# FlowAI's settings: one file for the whole stack. Copy it to .env (next to docker-compose.yml) and fill it in.
#
#   cp .env.example .env
#
# Who reads it:
#   - the API, worker and scheduler (Laravel): docker compose mounts it as backend/.env
#   - the assistant (assistant/): docker compose passes it in, and run on its own it reads ../.env
#   - docker compose itself: the *_PORT values below
# A setting both read (the Ollama Cloud key, VoiceStudio, ENGINE_KEY, SOUND_URL) is written once.
# The Models page (/dashboard/models) shows each connector's settings, which are set, and tests them.
#
# Quote any value with spaces in it ("like this"): Laravel won't start otherwise.
# After editing: docker compose up -d (it recreates the assistant), then docker compose restart api worker scheduler.

# --- Ports on this machine (docker compose) ---
# FRONTEND_PORT=5173
# API_PORT=8002
# ASSISTANT_PORT=8003
# MAILPIT_UI_PORT=8025


# =====================================================================================================
#  FlowAI's API (Laravel)
# =====================================================================================================

APP_NAME=FlowAI
APP_ENV=local
# Made on the API's first start
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:5175

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# false: every account counts as confirmed and no confirmation email goes out (local work)
AUTH_VERIFY_EMAIL=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@flowai.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social login. Leave blank to keep a provider switched off; its button will say so.
# Callback URLs to register with each provider:
#   Google: http://localhost:5173/oauth/google/callback
#   GitHub: http://localhost:5173/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# =====================================================================================================
#  Text models (Models page: Anthropic, Groq, OpenRouter, Ollama Cloud, Ollama, Model gateway)
# =====================================================================================================

# Claude, for the composer, the campaign agents and the intake. Key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Groq: free key at https://console.groq.com/keys (fast Llama 3.3 70B, free tier)
GROQ_API_KEY=
# OpenRouter: free key at https://openrouter.ai/keys (the picker lists the ':free' models)
OPENROUTER_API_KEY=
# Ollama Cloud (ollama.com): hosted big models, the default writer, and the assistant's own model.
# API + assistant. Key at https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=
# Ollama on this machine: off by default (docker compose --profile local-ollama up -d ollama, then
# OLLAMA_URL=http://ollama:11434).
OLLAMA_URL=

# Text models through any OpenAI-compatible gateway: Ollama Cloud (https://ollama.com/v1), OpenRouter,
# a team gateway, vLLM or LM Studio. Its models are discovered from GET {url}/models.
# AI_GATEWAY_REACH is only the label the model picker shows.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_GATEWAY_REACH=Gateway

# Which models write and plan in FlowAI
AI_DEFAULT_TEXT=ollama_cloud/glm-5.3-flash
AI_AGENTS_MODEL=ollama_cloud/glm-5.3-flash


# =====================================================================================================
#  Pictures and videos in the cloud (Models page: Higgsfield, Google Gemini)
# =====================================================================================================

HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_PLAN=ideogram-4,wan-2-7-i2v,soul-v2,soul,soul-cinema,grok-image-2,kling-3-pro,seedance-2,hailuo-2-3
GEMINI_API_KEY=
GOOGLE_GENAI_URL=https://generativelanguage.googleapis.com/v1beta


# =====================================================================================================
#  The GPU pod (runpod/, one deploy; Models page: Your GPU pod, VoiceStudio)
#  Every URL changes with a new pod (https://<pod-id>-<port>.proxy.runpod.net); the keys don't, and
#  they come from runpod/env. The assistant reaches the pod; FlowAI's Creative Lab goes through it.
# =====================================================================================================

# ComfyUI's manager API, port 8001 (runpod/comfyui/API.md): pictures and videos. MANAGER_API_KEY from runpod/env.
COMFYUI_URL=
COMFYUI_API_KEY=
# What each workflow is for (shown to the assistant)
COMFYUI_DESCRIPTIONS=workflows/descriptions.yaml
COMFYUI_TIMEOUT_MINUTES=30

# VoiceStudio, port 8002: voices, and transcripts with word timing once Whisper large-v3 is installed
# (runpod/voicestudio/README.md). API + assistant: FlowAI's voices and the assistant's own voice.
# The key is its OMNIVOICE_API_KEY. Empty = the assistant speaks with OmniVoice on this machine's GPU.
VOICESTUDIO_URL=
VOICESTUDIO_KEY=

# ACE-Step 1.5 songs, port 8003 (ACESTEP_API_KEY). On this machine's GPU instead: http://music:8000, after
# docker compose --profile music up -d music. Empty = the composer's moods only.
MUSIC_URL=
MUSIC_API_KEY=
# LatentSync lip sync for dubbed videos, port 8004 (LIPSYNC_API_KEY). On this machine's GPU (8 GB free at
# least): http://lipsync:8000, after docker compose --profile lipsync up -d lipsync. Empty = dubbing is off.
LIPSYNC_URL=
LIPSYNC_API_KEY=
# Face swaps (inswapper_128 and GFPGAN in ONNX), port 8005 (FACESWAP_API_KEY). Empty = face swaps are off.
FACESWAP_URL=
FACESWAP_API_KEY=


# =====================================================================================================
#  How FlowAI and the assistant reach each other (Models page: The assistant service)
# =====================================================================================================

# Creative Lab sends its nodes to the assistant's engine: the pod's models, words on pictures, pictures to
# video. API + assistant: the API sends ENGINE_KEY and the assistant expects it; empty = no key (only on a
# private network).
ENGINE_URL=http://assistant:8000
ENGINE_KEY=
# YouTube nodes (yt-dlp): a cookies file (Netscape format) for when YouTube asks the server to sign in.
YTDLP_COOKIES=

# FlowAI Sound (sound/): off by default, the pod does its work. API + assistant. To run it here:
# docker compose --profile local-sound up -d sound, and SOUND_URL=http://sound:8000.
SOUND_URL=


# =====================================================================================================
#  The assistant (assistant/): the voice agent on the Assistant page
# =====================================================================================================

# --- Its model, on Ollama Cloud (the key is OLLAMA_CLOUD_API_KEY above) ---
OLLAMA_HOST=https://ollama.com
LLM_MODEL=glm-5.3-flash
# Other Ollama cloud models tested as the agent: deepseek-v4.1-flash, gemma4:31b (see assistant/README.md, Tuning).
# true | false | low | medium | high. GLM 5.3 Flash leaks reasoning into the spoken reply when this is
# false, so "low" is the fastest clean setting.
LLM_THINK=low

# --- Listening (NVIDIA Nemotron 3.5 ASR) ---
ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
# "auto" detects the language; or force a locale like en-US, fr-FR
ASR_LANGUAGE=auto
# streaming = partial transcripts while you talk; offline = transcribe once you stop
ASR_MODE=streaming
# Lookahead tokens -> latency: 0=80ms, 3=320ms, 6=560ms, 13=1120ms
ASR_LOOKAHEAD=3
ASR_DEVICE=cuda
ASR_DTYPE=float16

# --- Its voice: VoiceStudio above, or OmniVoice on this machine's GPU when VOICESTUDIO_URL is empty ---
TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE=cuda
# float32 on GTX 16xx (fp16 there is slow and gives garbled audio); float16 is fine on RTX cards
TTS_DTYPE=float32
# Diffusion steps. 8 is ~2x faster than 16 with no intelligibility loss in tests
TTS_NUM_STEP=8
TTS_SPEED=1.0
# Voice used to create the default voice once (cached in voices/default.pt)
TTS_VOICE_INSTRUCT="female, moderate pitch, american accent"
# Optional: clone a voice instead (wav file, ~5-15 s). If TTS_REF_TEXT is empty the clip is transcribed
# automatically with the ASR model.
TTS_REF_AUDIO=
TTS_REF_TEXT=
# The voice until the user picks one on the page: a VoiceStudio voice profile's name or id, or a catalog
# voice's id (e.g. feat_04_the_neighbor). Empty = the server's oldest profile. Not an OpenAI name like
# alloy: VoiceStudio gives those a different random voice every sentence.
TTS_VOICE=

# --- Turn taking (server-side VAD) ---
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250

# --- Browser agent (Playwright); docker compose switches it off ---
BROWSER_ENABLED=true
# The site the agent works on; it opens here at startup
WEBSITE_URL=https://demo.playwright.dev/todomvc/
# false = visible Chromium window (WSLg/desktop); forced true when there is no display
BROWSER_HEADLESS=false
# Cookies and logins persist in this folder: log in once in the window and it sticks
BROWSER_PROFILE_DIR=browser-profile
# Empty = same model as LLM_MODEL
BROWSER_LLM_MODEL=
BROWSER_LLM_THINK=low
BROWSER_MAX_STEPS=25
BROWSER_SCREENSHOTS=true
SKILLS_DIR=skills

# --- Files and the content studio ---
# Generated and attached files are kept here and shown in the web UI
MEDIA_DIR=media
# Conversations are kept here, so they can be listed and reopened (not served)
DATA_DIR=data
# How to make each kind of post: one markdown file per skill (see assistant/skills/content/_template.md)
CONTENT_SKILLS_DIR=skills/content
# Fonts for text on pictures: any .ttf/.otf file here can be used by its file name
FONTS_DIR=fonts

# --- FlowAI, from the assistant: saving, finding and scheduling posts ---
# docker compose sets FLOWAI_URL (http://api:8000). Run on its own: http://localhost:8002.
FLOWAI_URL=
# The dashboard: links to posts point here. Until FlowAI issues the assistant a token, the assistant signs
# in as this user, and FlowAI only accepts that from one of its SANCTUM_STATEFUL_DOMAINS.
FLOWAI_DASHBOARD_URL=http://localhost:5173
FLOWAI_EMAIL=
FLOWAI_PASSWORD=

# --- The team's phone (hackathon Phone API): posting from its Instagram and X apps ---
# The API base and the team key; the console (https://172.26.0.32/team, sign in with the key) shows the
# phone live. Empty URL = off.
PHONE_API_URL=
PHONE_API_KEY=
# The hackathon server's certificate is self-signed
PHONE_VERIFY_TLS=false
# Who drives the phone: agent (the phone's own agent, on the organisers' model account); auto (the phone's
# agent, and ours takes a job over when that one fails or hangs, e.g. its account out of balance); direct
# (always ours: it looks at screenshots with PHONE_VISION_MODEL on our Ollama account and taps and types itself).
# The switch on the Assistant page (a draft's From the phone panel) changes it, and its pick is kept from then on.
PHONE_DRIVER=agent
PHONE_VISION_MODEL=kimi-k3
# Our agent sends the phone one input at a time, at least this many seconds apart
PHONE_ACTION_GAP_SECONDS=5
# auto: after the phone's agent had no model to think with, ours starts the jobs for this long
PHONE_AGENT_RETRY_MINUTES=30
# The phone's agent: flash for feedback and other tasks; pro for posting also checks that the post went up
PHONE_MODE=flash
PHONE_POST_MODE=pro
PHONE_MAX_STEPS=40
# How to post and read feedback in each app (one markdown file per skill, see assistant/skills/phone/_template.md)
PHONE_SKILLS_DIR=skills/phone
# Check a post's likes, comments and views this long after it went up (0 = only when asked)
PHONE_FEEDBACK_AFTER_MINUTES=60
# While posting, the phone asks an OK for plain input it can't check (Enter in a field it can't read): give it
# by itself, as part of the post you asked for (false: the assistant asks you each time)
PHONE_AUTO_APPROVE_POSTS=true

# Publish the posts FlowAI schedules from this phone when their time comes. FlowAI's agent token from its
# Phones page; empty = fetched by signing in with FLOWAI_EMAIL and FLOWAI_PASSWORD. In FlowAI, add the phone
# on the Phones page (Automation service, device ID heracles-phone) and pick it, with automation on, for each
# Instagram and X account.
PHONE_PUBLISH=true
FLOWAI_AGENT_TOKEN=
# The phone's device ID in FlowAI; empty = the phone API's own (heracles-phone)
PHONE_DEVICE_REF=
PHONE_PUBLISH_POLL_SECONDS=15
