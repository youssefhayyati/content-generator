# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
HTTP_PORT=8090
DB_PASSWORD=

APP_NAME=FlowAI
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://SERVER_IP:8090
FRONTEND_URL=http://SERVER_IP:8090
SANCTUM_STATEFUL_DOMAINS=SERVER_IP:8090
# Plain HTTP (no domain, no certificate), so the session cookie can't be Secure.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# No mail service yet: emails (confirmation and reset links) are written to the log at debug level:
#   docker compose -p flowai logs app | grep -A3 verify-email
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@flowai.test"
MAIL_FROM_NAME=FlowAI

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# FlowAI Sound (sound/): voices, listening and the composer. docker compose runs it.
SOUND_URL=http://sound:8000
